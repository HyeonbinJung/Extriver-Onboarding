name: Discover Korean influencers hourly

on:
  schedule:
    # 17 minutes past every UTC hour; avoids the high-traffic top-of-hour.
    - cron: "17 * * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: korean-influencer-discovery
  cancel-in-progress: false

jobs:
  discover:
    runs-on: ubuntu-latest
    timeout-minutes: 35
    steps:
      - name: Checkout default branch
        uses: actions/checkout@v4
        with:
          ref: main

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: requirements-korean-leads.txt

      - name: Install dependencies
        run: pip install -r requirements-korean-leads.txt

      - name: Research and append up to 30 Korean leads
        env:
          SERPER_API_KEY: ${{ secrets.SERPER_API_KEY }}
          MAX_LEADS: "30"
          MAX_QUERIES: "36"
          MAX_RUNTIME_SECONDS: "1500"
        run: python scripts/discover_korean_influencers.py

      - name: Commit newly verified contacts
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/korean_influencer_leads.csv
          if git diff --cached --quiet; then
            echo "No new contacts discovered in this run."
            exit 0
          fi
          git commit -m "data: append Korean influencer contacts [skip ci]"
          git pull --rebase origin main
          git push origin HEAD:main
